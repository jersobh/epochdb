# EpochDB Core Engine Configuration

# Embedding Model Provider Options:
# 1. Local Offline (Default): "all-MiniLM-L6-v2", "barisaydin/gte-base"
# 2. OpenAI: "openai:text-embedding-3-small", "openai:text-embedding-3-large", "openai:text-embedding-ada-002"
# 3. Google/Gemini: "google:text-embedding-004", "google:gemini-embedding-2"
# 4. Ollama: "ollama:all-minilm" (requires running local Ollama service)
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIM=384

# API Keys (Required if using cloud provider models)
OPENAI_API_KEY=
GEMINI_API_KEY=

# Custom API Proxies (Optional, for OpenAI-compatible APIs)
OPENAI_BASE_URL=
